# GameVerse - Configuración de Variables de Entorno
# Copia este archivo a '.env' para tu entorno local.
# NUNCA subas archivos con claves o secretos reales a GitHub.

# Puerto de ejecución del servidor
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave de la API externa de RAWG (obtener gratis en https://rawg.io/apidocs)
# Si no está configurada, GameVerse utiliza automáticamente la API REST abierta de FreeToGame
RAWG_API_KEY=PEGA_AQUI_TU_CLAVE_RAWG_REAL

# Secreto para firma criptográfica de tokens JWT
JWT_SECRET=secreto_seguro_gameverse_desarrollo_web_2026_salt

# Origen CORS para solicitudes cliente
CLIENT_ORIGIN=http://localhost:3000

# Ruta de la base de datos persistente SQLite
DATABASE_PATH=./data/gameverse.sqlite
