# GameVerse - Variables de Entorno del Servidor
# IMPORTANTE: Copia este archivo a 'server/.env' o define las variables en tu entorno.
# NUNCA subas archivos .env con credenciales reales a GitHub.

# Puerto del servidor (en este entorno se utiliza el puerto 3000)
PORT=3000

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Clave de la API externa de RAWG (obtener gratis en https://rawg.io/apidocs)
# Si no se configura o no es válida, GameVerse utiliza automáticamente la API REST de FreeToGame
RAWG_API_KEY=PEGA_AQUI_TU_CLAVE_RAWG_REAL

# Clave secreta para firmar tokens JWT de sesión (utiliza una cadena aleatoria y segura)
JWT_SECRET=reemplazar_con_secreto_aleatorio_muy_largo_y_seguro_gameverse_2026

# Origen permitido por CORS para el cliente frontend
CLIENT_ORIGIN=http://localhost:3000

# Ruta del archivo de base de datos SQLite persistente
DATABASE_PATH=./data/gameverse.sqlite
